package views

import db "servidor-NotifyEd/db/sqlc"

// Layout define la estructura base HTML con Pico.css como hoja de estilos
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<!-- Pico.css CDN para estilos limpios y semánticos -->
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
		</head>
		<body>
			<header class="container" style="margin-top: 1.5rem; margin-bottom: 1.5rem;">
				<hgroup>
					<h1>📢 NotifyEd</h1>
					<p>Sistema de gestión de materias y avisos universitarios (SSR con templ)</p>
				</hgroup>
			</header>
			<main class="container">
				{ children... }
			</main>
			<footer class="container" style="margin-top: 3rem; text-align: center;">
				<small>NotifyEd &bull; Trabajo Práctico de Programación Web &bull; Renderizado en servidor con templ</small>
			</footer>
		</body>
	</html>
}

// IndexPage integra el layout general, el formulario y la lista de entidades
templ IndexPage(courses []db.Course) {
	@Layout("NotifyEd - Gestión de Materias") {
		<div class="grid">
			<section>
				@EntityForm()
			</section>
			<section>
				@EntityList(courses)
			</section>
		</div>
	}
}

