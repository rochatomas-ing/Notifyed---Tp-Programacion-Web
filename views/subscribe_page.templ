package views

import (
	"fmt"
	db "servidor-NotifyEd/db/sqlc"
)

// SubscribePage renderiza la pantalla de suscripción del alumno estilo login
templ SubscribePage(semester db.GetSemesterByTokenRow, professorName string, studentEmail string, errorMessage string, isSuccess bool) {
	<!DOCTYPE html>
	<html lang="es" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>NotifyEd - Suscripción a { semester.CourseName }</title>
			<!-- Pico.css v2 CDN -->
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<!-- HTMX para dinamismo SPA -->
			<script src="/static/htmx.min.js"></script>
			<style>
				:root {
					--pico-primary: #1e40af;
					--pico-primary-background: #1e40af;
					--pico-primary-hover: #1d4ed8;
					--pico-primary-hover-background: #1d4ed8;
					--pico-primary-focus: rgba(30, 64, 175, 0.2);
					--pico-background-color: #f8fafc;
					--pico-card-background-color: #ffffff;
					--pico-muted-border-color: #e2e8f0;
					--pico-color: #1e293b;
				}
				body {
					background: radial-gradient(circle at top, #f1f5f9 0%, #f8fafc 100%);
					color: #1e293b;
					min-height: 100vh;
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					padding: 1.5rem 1rem;
				}
				.login-box {
					width: 100%;
					max-width: 440px;
					background-color: #ffffff;
					border: 1px solid #e2e8f0;
					border-radius: 1rem;
					box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
					padding: 2rem;
				}
				.brand-header {
					display: flex;
					align-items: center;
					justify-content: center;
					gap: 0.6rem;
					margin-bottom: 1.5rem;
				}
				.brand-header img {
					height: 38px;
					width: auto;
					filter: drop-shadow(0 2px 4px rgba(15, 23, 42, 0.2));
					background: #0f172a;
					padding: 6px;
					border-radius: 8px;
				}
				.badge-subject {
					display: inline-block;
					background-color: #eff6ff;
					color: #1d4ed8;
					border: 1px solid #bfdbfe;
					font-size: 0.78rem;
					font-weight: 600;
					padding: 0.2rem 0.6rem;
					border-radius: 9999px;
					margin-bottom: 0.5rem;
				}
				.success-icon {
					width: 52px;
					height: 52px;
					background-color: #dcfce7;
					border: 2px solid #bbf7d0;
					border-radius: 50%;
					display: flex;
					align-items: center;
					justify-content: center;
					margin: 0 auto 1rem;
					color: #15803d;
				}
				.google-btn {
					width: 100%;
					display: flex;
					align-items: center;
					justify-content: center;
					gap: 0.6rem;
					background-color: #ffffff;
					color: #64748b;
					border: 1px solid #cbd5e1;
					border-radius: 0.5rem;
					padding: 0.6rem 1rem;
					font-size: 0.88rem;
					font-weight: 500;
					cursor: not-allowed;
					opacity: 0.75;
				}
			</style>
		</head>
		<body>
			<div class="brand-header">
				<img src="/static/logo.png" alt="Logo NotifyEd"/>
				<div>
					<h2 style="font-size: 1.4rem; font-weight: 700; margin: 0; color: #0f172a; letter-spacing: -0.025em;">NotifyEd</h2>
					<small style="color: #64748b; font-size: 0.78rem;">Portal de Suscripción de Alumnos</small>
				</div>
			</div>

			@SubscribeBox(semester, professorName, studentEmail, errorMessage, isSuccess)

			<footer style="margin-top: 2rem; text-align: center; color: #94a3b8; font-size: 0.78rem;">
				NotifyEd &bull; Sistema de Avisos Universitarios
			</footer>
		</body>
	</html>
}

// SubscribeBox renderiza la tarjeta central símil login (reemplazable in-situ vía HTMX)
templ SubscribeBox(semester db.GetSemesterByTokenRow, professorName string, studentEmail string, errorMessage string, isSuccess bool) {
	<div class="login-box">
		<div style="text-align: center; margin-bottom: 1.25rem;">
					<span class="badge-subject">Cursada Universitaria</span>
					<h3 style="font-size: 1.4rem; font-weight: 700; color: #0f172a; margin-bottom: 0.25rem;">{ semester.CourseName }</h3>
					<p style="color: #64748b; font-size: 0.85rem; margin-bottom: 0;">
						Ciclo { fmt.Sprintf("%d", semester.Year) } &bull; Docente: { professorName }
					</p>
				</div>

				if isSuccess {
					<div style="text-align: center; padding: 0.5rem 0;">
						<div class="success-icon">
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="20 6 9 17 4 12"></polyline>
							</svg>
						</div>
						<h4 style="color: #15803d; margin-bottom: 0.4rem; font-size: 1.2rem; font-weight: 700;">¡Suscripción confirmada!</h4>
						<p style="color: #475569; font-size: 0.9rem; margin-bottom: 1rem;">
							Has quedado registrado/a exitosamente en la cursada con el correo:
						</p>
						<div style="margin-bottom: 1.25rem;">
							<code style="font-size: 0.95rem; background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; padding: 0.35rem 0.7rem; border-radius: 6px;">
								{ studentEmail }
							</code>
						</div>
						<p style="color: #64748b; font-size: 0.82rem; margin-bottom: 1.5rem; line-height: 1.4;">
							Recibirás avisos de clases, exámenes y novedades directamente en esta casilla.
						</p>
						<a
							href={ templ.SafeURL(fmt.Sprintf("/subscribir/%s", semester.SubToken)) }
							role="button"
							class="outline"
							style="font-size: 0.85rem; padding: 0.4rem 0.85rem;"
						>
							Registrar otro correo
						</a>
					</div>
				} else if !semester.IsOpen {
					<div style="text-align: center; padding: 1rem 0;">
						<div style="background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 1.25rem; color: #991b1b;">
							<h4 style="color: #991b1b; margin-bottom: 0.4rem; font-size: 1.1rem; font-weight: 700;">Inscripciones Cerradas</h4>
							<p style="font-size: 0.88rem; margin-bottom: 0;">
								El plazo de inscripción para esta cursada finalizó el { semester.EndDate.Format("02/01/2006") }. Si necesitas sumarte, contacta directamente al equipo docente.
							</p>
						</div>
					</div>
				} else {
					if errorMessage != "" {
						<div style="background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 6px; padding: 0.6rem 0.8rem; color: #991b1b; font-size: 0.85rem; margin-bottom: 1rem;">
							{ errorMessage }
						</div>
					}

					<form
						method="POST"
						action={ templ.SafeURL(fmt.Sprintf("/subscribir/%s", semester.SubToken)) }
						hx-post={ fmt.Sprintf("/subscribir/%s", semester.SubToken) }
						hx-target=".login-box"
						hx-swap="outerHTML"
						style="margin-bottom: 0;"
					>
						<label for="student-email" style="font-weight: 600; color: #1e293b; margin-bottom: 0.4rem; display: block; font-size: 0.88rem;">
							Correo institucional o personal
							<input
								type="email"
								id="student-email"
								name="email"
								value={ studentEmail }
								placeholder="nombre.apellido@alumnos.edu.ar"
								required
								autocomplete="email"
								autofocus
								style="margin-top: 0.35rem; font-size: 0.95rem;"
							/>
						</label>
						<small style="display: block; color: #64748b; margin-top: -0.4rem; margin-bottom: 1.25rem; font-size: 0.78rem;">
							Asegúrate de que sea tu correo habitual para no perder comunicaciones docentes.
						</small>

						<button
							type="submit"
							class="primary"
							style="width: 100%; font-weight: 600; padding: 0.65rem; font-size: 0.95rem; margin-bottom: 0;"
						>
							Suscribirme a la cursada
						</button>
					</form>

					<div style="display: flex; align-items: center; text-align: center; margin: 1.25rem 0 1rem; color: #94a3b8;">
						<div style="flex: 1; border-bottom: 1px solid #e2e8f0;"></div>
						<span style="padding: 0 0.6rem; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500;">
							Otras opciones
						</span>
						<div style="flex: 1; border-bottom: 1px solid #e2e8f0;"></div>
					</div>

					<button
						type="button"
						disabled
						class="google-btn"
						title="Próximamente disponible con autenticación de Google"
					>
						<svg width="18" height="18" viewBox="0 0 24 24">
							<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path>
							<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path>
							<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"></path>
							<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"></path>
						</svg>
						Ingresar con cuenta Google (Próximamente)
					</button>
				}
			</div>
}

