package views

import (
	"fmt"
	db "servidor-NotifyEd/db/sqlc"
)

// NoticesPage renderiza la página completa del Historial de Avisos (carga tradicional)
templ NoticesPage(
	notices []db.ListNoticesFilteredRow,
	courses []db.Course,
	semesters []db.ListSemestersWithCourseByProfessorRow,
	selectedCourseId string,
	selectedSemesterId string,
	professorName string,
) {
	@Layout("NotifyEd - Historial de Avisos", "avisos", professorName) {
		@NoticesContent(notices, courses, semesters, selectedCourseId, selectedSemesterId, false)
	}
}

// NoticesContent renderiza el contenido del Historial de Avisos (reutilizable en HTMX)
templ NoticesContent(
	notices []db.ListNoticesFilteredRow,
	courses []db.Course,
	semesters []db.ListSemestersWithCourseByProfessorRow,
	selectedCourseId string,
	selectedSemesterId string,
	isHTMX bool,
) {
	if isHTMX {
		@TopNavBar("avisos", true)
	}
	<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
		<hgroup style="margin-bottom: 0;">
			<h2>Historial de Avisos</h2>
			<p>Consulta los avisos publicados para tus cursadas (ordenados por el más reciente).</p>
		</hgroup>
		<a
			href="/publicar-aviso"
			hx-get="/publicar-aviso"
			hx-target="#main-content"
			hx-push-url="true"
			role="button"
			class="primary"
		>
			Publicar nuevo aviso
		</a>
	</div>

	<!-- Filtros de búsqueda dinámicos con HTMX -->
	<article style="padding: 1.25rem; margin-bottom: 2rem;">
		<header style="margin-bottom: 0.75rem;">
			<h5 style="margin-bottom: 0;">Filtrar avisos</h5>
		</header>
		<form method="GET" action="/avisos" id="notices-filter-form" style="margin-bottom: 0;">
			<div class="grid">
				<div>
					<label for="filter-course">Por Materia:</label>
					<select
						id="filter-course"
						name="course_id"
						hx-get="/avisos"
						hx-trigger="change"
						hx-target="#notices-list-container"
						hx-swap="innerHTML"
						hx-include="#notices-filter-form"
						hx-push-url="true"
					>
						<option value="">-- Todas las materias --</option>
						for _, c := range courses {
							<option
								value={ c.IDCourse.String() }
								selected?={ c.IDCourse.String() == selectedCourseId }
							>
								{ c.Name }
							</option>
						}
					</select>
				</div>

				<div>
					<label for="filter-semester">Por Cursada:</label>
					<select
						id="filter-semester"
						name="semester_id"
						hx-get="/avisos"
						hx-trigger="change"
						hx-target="#notices-list-container"
						hx-swap="innerHTML"
						hx-include="#notices-filter-form"
						hx-push-url="true"
					>
						<option value="">-- Todas las cursadas --</option>
						for _, s := range semesters {
							<option
								value={ s.IDSemester.String() }
								selected?={ s.IDSemester.String() == selectedSemesterId }
							>
								{ s.CourseName } ({ fmt.Sprintf("%d", s.Year) })
							</option>
						}
					</select>
				</div>
			</div>
			<div style="display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 0.5rem;">
				if selectedCourseId != "" || selectedSemesterId != "" {
					<a
						href="/avisos"
						hx-get="/avisos"
						hx-target="#main-content"
						hx-push-url="true"
						role="button"
						class="outline secondary"
						style="margin-bottom: 0;"
					>
						Limpiar filtros
					</a>
				}
				<button type="submit" class="secondary" style="margin-bottom: 0; width: auto;">
					Filtrar
				</button>
			</div>
		</form>
	</article>

	<!-- Contenedor dinámico del Listado de Avisos -->
	<div id="notices-list-container">
		@NoticesList(notices)
	</div>
}

// NoticesList renderiza la lista de avisos (reemplazable parcialmente)
templ NoticesList(notices []db.ListNoticesFilteredRow) {
	if len(notices) == 0 {
		<article style="text-align: center; padding: 2.5rem 1rem;">
			<h4>No hay avisos encontrados</h4>
			<p><em>No se han publicado avisos o no coinciden con los filtros seleccionados.</em></p>
			<a
				href="/publicar-aviso"
				hx-get="/publicar-aviso"
				hx-target="#main-content"
				hx-push-url="true"
				role="button"
				class="primary"
				style="margin-top: 0.5rem;"
			>
				Crear primer aviso
			</a>
		</article>
	} else {
		<div style="display: flex; flex-direction: column; gap: 1.25rem;">
			for _, n := range notices {
				<article style="margin-bottom: 0;" id={ "notice-card-" + n.IDNotice.String() }>
					<header style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem;">
						<div>
							<h4 style="margin-bottom: 0.25rem;">{ n.Title }</h4>
							<small style="color: var(--pico-muted-color);">
								<strong>{ n.CourseName }</strong> (Cursada { fmt.Sprintf("%d", n.SemesterYear) }) &bull; Publicado el { n.CreatedAt.Format("02/01/2006 a las 15:04") } hs
							</small>
						</div>
						<form
							method="POST"
							action="/avisos/delete"
							hx-post="/avisos/delete"
							hx-target="#notices-list-container"
							hx-swap="innerHTML"
							style="margin: 0;"
						>
							<input type="hidden" name="id" value={ n.IDNotice.String() }/>
							<button
								type="submit"
								class="outline secondary"
								style="padding: 0.2rem 0.5rem; font-size: 0.75rem; margin: 0;"
								onclick="return confirm('¿Seguro que deseas eliminar este aviso?');"
							>
								Eliminar
							</button>
						</form>
					</header>
					<p style="white-space: pre-wrap; margin-top: 0.75rem; font-size: 0.95rem;">{ n.Message }</p>
				</article>
			}
		</div>
	}
}
